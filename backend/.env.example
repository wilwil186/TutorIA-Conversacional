# Which provider to use when the app doesn't specify one.
# "ollama" = local open-source (free), "anthropic" = Claude, "openai" = OpenAI.
DEFAULT_PROVIDER=ollama

# --- Open source (Ollama) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Claude (only if used; the app can also pass the key per request) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- OpenAI (only if used) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=   # set for OpenAI-compatible servers (Groq, OpenRouter, ...)

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
